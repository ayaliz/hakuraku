{
  "name": "hakuraku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.14",
    "@uiw/react-codemirror": "^4.25.4",
    "dotenv": "^17.4.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "katex": "^0.16.28",
    "lodash": "^4.17.23",
    "memoize-one": "^6.0.0",
    "pako": "^2.1.0",
    "pg": "^8.20.0",
    "react": "^19",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.0",
    "wanakana": "^5.3.1",
    "webm-muxer": "^5.1.4"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:github-pages-redirect": "node --import tsx tools/build-github-pages-redirect-site.mts",
    "build:cloudflare": "node --import tsx tools/build-cloudflare-site.mts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:race-api": "node --import tsx tools/dev-race-platform-api.mts",
    "deploy:cloudflare": "yarn build:cloudflare && wrangler deploy",
    "backfill:races": "node --import tsx tools/backfill-races-to-r2-postgres.mts",
    "enqueue:umalogs-refresh": "node --import tsx tools/enqueue-umalogs-refresh.mts",
    "upload:race-archive": "node --import tsx tools/upload-race-archive-to-r2.mts",
    "repack:r2-gzip": "node --import tsx tools/repack-r2-gzip.mts",
    "repair:aptitudes": "node --import tsx tools/repair-race-entry-aptitudes.mts",
    "rebuild:race-entry-search": "node --import tsx tools/rebuild-race-entry-search-data.mts",
    "rebuild:replay-index": "node --import tsx tools/rebuild-replay-index.mts",
    "repair:missing-replay-index": "node --import tsx tools/repair-missing-replay-index.mts",
    "refresh:umalogs-cache": "node --max-old-space-size=12288 --import tsx tools/refresh-umalogs-cache.mts",
    "refresh:umalogs-worker": "node --import tsx tools/run-umalogs-refresh-worker.mts",
    "build:shop-refresh": "node scripts/build-shop-refresh-data.mjs",
    "embed:course-data": "node tools/embed-course-data-into-gamedata.mjs",
    "protoc": "protoc --es_out=target=ts:src/data --python_out=umdb/ --pyi_out=umdb/ --proto_path=umdb/ umdb/*.proto",
    "precompute": "node --max-old-space-size=12288 --expose-gc --import tsx scripts/precompute-umalogs.mts"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.2.3",
    "@types/pako": "^2.0.4",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.4",
    "sharp": "^0.34.5",
    "ts-trueskill": "^5.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "4.81.0"
  },
  "packageManager": "yarn@4.12.0"
}
